# Server Configuration
PORT=5002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL by default)
# Example for local Postgres: postgresql://postgres:password@localhost:5432/crea_ai?schema=public
# Example for Supabase/Neon: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/crea_ai?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crea_ai?schema=public"

# JWT Secrets (Generate secure random 64-character strings in production)
JWT_ACCESS_SECRET=crea_ai_super_secret_jwt_access_key_2026_change_in_prod
JWT_REFRESH_SECRET=crea_ai_super_secret_jwt_refresh_key_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Configuration (for sending real email OTPs)
# Leave blank to use development fallback (Ethereal test mail + console logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CREA AI <security@crea-ai.internal>"

# OAuth Credentials (Optional / for Google & Apple Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
