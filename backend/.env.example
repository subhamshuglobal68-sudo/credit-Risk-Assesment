# Copy to .env and adjust. Never commit the real .env.
FLASK_DEBUG=1
SECRET_KEY=dev-insecure-change-me

# Leave blank to use the default SQLite database under backend/instance/.
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/credit_risk
DATABASE_URL=

LOG_LEVEL=INFO

# Probability-of-default cutoffs for Low/Medium/High banding.
RISK_LOW_THRESHOLD=0.33
RISK_HIGH_THRESHOLD=0.66

# History pagination.
HISTORY_DEFAULT_PER_PAGE=20
HISTORY_PER_PAGE_CAP=100

# Overrides (defaults shown).
# MODEL_DIR=ml/artifacts
# DATA_PATH=data/german_credit.csv
