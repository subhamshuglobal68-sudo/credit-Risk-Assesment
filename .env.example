# ==============================================================================
# CREA AI & Credit-Risk Scoring System — Unified Environment Template
# Copy this file to .env or use the respective service-level .env files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend ML API (Port 5000)
# ------------------------------------------------------------------------------
BACKEND_PORT=5000
BACKEND_HOST=127.0.0.1
BACKEND_SECRET_KEY=dev-insecure-backend-key
BACKEND_DATABASE_URL=
RISK_LOW_THRESHOLD=0.33
RISK_HIGH_THRESHOLD=0.66

# ------------------------------------------------------------------------------
# 2. Frontend Flask Application (Port 5001)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5001
FRONTEND_HOST=127.0.0.1
FRONTEND_SECRET_KEY=dev-insecure-frontend-key
BACKEND_URL=http://127.0.0.1:5000
AUTH_URL=http://127.0.0.1:5002

# ------------------------------------------------------------------------------
# 3. Auth Server (Port 5002 - Node.js Express & Prisma)
# ------------------------------------------------------------------------------
AUTH_PORT=5002
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crea_ai?schema=public"

JWT_ACCESS_SECRET=crea_ai_super_secret_jwt_access_key_2026_dev
JWT_REFRESH_SECRET=crea_ai_super_secret_jwt_refresh_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional SMTP Settings (leave blank for automatic Ethereal console email previews in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CREA AI Security <security@crea-ai.internal>"

# ------------------------------------------------------------------------------
# 4. Client Web App (Port 5173 - React Vite) & Supabase
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
