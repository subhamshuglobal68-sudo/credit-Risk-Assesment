# Frontend Configuration (.env.example)
# Copy to .env and adjust as necessary for your environment.

# Host & Port for Frontend Flask Web Application
PORT=5001
HOST=127.0.0.1
FLASK_DEBUG=1
SECRET_KEY=crea-credit-risk-frontend-dev-key

# URL to the Backend ML API service (Port 5000)
BACKEND_URL=http://127.0.0.1:5000

# URL to the CREA AI Auth Server (Port 5002)
AUTH_URL=http://127.0.0.1:5002
